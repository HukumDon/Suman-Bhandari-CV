# Copy this file to .env for local development (Prisma only reads .env).
# On Vercel, add the same variables under Project Settings > Environment Variables.
# Never commit real values.

# PostgreSQL connection string (Neon, Supabase, Vercel Marketplace Postgres, or local Docker).
# Local Docker example (see docker-compose.yml):
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio"

# Random secret used to hash visitor IP addresses for rate limiting.
# Generate one with:  openssl rand -hex 32
IP_HASH_SALT=""

# Public URL of the site. Used for SEO tags, sitemap and social previews.
# On Vercel this falls back to the production domain automatically if left unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: email yourself whenever someone sends a message (https://resend.com).
# Leave blank to store messages in the database only.
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
